{
  "functions": {
    "server.mjs": {
      "runtime": "@vercel/node",
      "includeFiles": [
        "assets/**",
        "data/**",
        "lib/**",
        "index.html",
        "styles.css",
        "script.js",
        "bible-data.js"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server.mjs"
    }
  ]
}
