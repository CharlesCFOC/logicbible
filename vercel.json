{
  "buildCommand": "npm run build:updates",
  "builds": [
    {
      "src": "api/[...path].mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/**",
          "lib/**"
        ]
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/mobile-updates/latest.json",
      "headers": {
        "Cache-Control": "no-store",
        "Access-Control-Allow-Origin": "https://localhost",
        "Vary": "Origin"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].mjs"
    },
    {
      "handle": "filesystem"
    }
  ]
}
