{
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "api/[...path].mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["data/**", "lib/**"]
      }
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "bible-data.js",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "scripts/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].mjs"
    },
    {
      "handle": "filesystem"
    }
  ]
}
