API_BIBLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Read aloud: Google Cloud Text-to-Speech (Neural2), used only by the server.
# Enable Cloud Text-to-Speech and billing; restrict this key to that API.
GOOGLE_CLOUD_TTS_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Persistent AI provider-call caps (UTC windows; retries also count).
AI_USER_HOURLY_LIMIT=60
AI_USER_DAILY_LIMIT=200
AI_GLOBAL_DAILY_LIMIT=2000
